# Notion integration secret (keep private)
# Required on the local PC for the one-click transcript workflow.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxx

# Easy German Study data source created in Notion
NOTION_DATA_SOURCE_ID=6878c89b-220b-4dc4-96a1-ae021d37a2b3

# Browser used only on the local PC when YouTube needs login cookies.
# Supported examples: chrome, edge, firefox
YOUTUBE_BROWSER=chrome

# Easy German A2 playlist
A2_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLk1fjOl39-5201BUdhtOM_x23poNvLouT

# OpenAI is used by GitHub Actions, not by fetch_requested_transcripts_local.py.
# Keep these as GitHub Secrets for the normal workflow.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5-mini
